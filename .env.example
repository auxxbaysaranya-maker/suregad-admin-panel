# Copy to .env. These values are public in the browser. Do not put server secrets here.

# Origin of the SureGad API (no trailing slash). Leave empty locally: Vite proxies /api to http://localhost:4000.
# Production: https://suregad-backend.onrender.com (the Pages workflow uses it by default)
VITE_API_URL=

# Path the site is served from. "/" locally; the GitHub Pages workflow sets "/<repo-name>/".
VITE_BASE_PATH=/

# Buyer marketplace, used for "View on marketplace" and chat links.
# Defaults: http://localhost:5173/ in development, the published marketplace in production.
VITE_MARKETPLACE_URL=

# Optional: Firebase web config. When set, the panel uses Firebase email/password + Google sign-in,
# password reset and email verification. Without it, the API's panel sign-in is used (development only).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
